# =============================================================================
# SmartCampusMedia .gitignore
# 原则: 只跟踪"我们编写/编写生成"的文本资产; 排除官方参考资料与 EDA 生成物
# =============================================================================

# ---------- 官方加密 IP（IEEE1735 加密, 版权归官方, 不入库）----------
ip/local/hdmi/enc/
project/hdmi/enc/

# ---------- 官方参考资料（本地保留, 不入库: 体积大且版权归官方）----------
project/reference/
ip/reference/

# ---------- 安路 TD 工程生成物 ----------
# .al 工程文件: 只保留 bringup_td.al（正式工程定义）
# 其余 .al 视为重复/临时工程（已发生: 用户于 project/src/ 下另建 SmartCampusMedia.al）
*.al
!project/bringup_td.al
project/*_Runs/
log/
*.log
*.logw
project/.lock.f
project/.stop.f
*.db
*.bit
*.bid
*.area
*.timing
*.tsm
*.tcl.bak
*.prj
*.ipc.orig
*.info
*.rpt
*.status
*.f

# ---------- ModelSim 仿真工作库 ----------
sim/msim_work/
work/
transcript
*.wlf
*.vcd
# 仿真导出的图像保留 PPM/PNG 小图证据; 大体积中间文件忽略
sim/msim_work/*.ppm

# ---------- 临时文件 ----------
reports/_*.png
*.bak
*~
~$*
.DS_Store
Thumbs.db
# VIDE 编辑器工程配置（非项目内容）
vide.toml
.vide/
